---
import about from '../data/about';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sobre mi" description="Sobre mi">
	{about.bio.split('\n\n').map((paragraph) => (
		<p>{paragraph}</p>
	))}

	<div class="about-extra">
		<div class="about-extra-item">
			<h4>Educación y Certificados</h4>
			<div class="about-extra-item-content">
				{about.education.map((item) => (
					<p>
						<strong>{item.title}</strong> - {item.year}
						<br />
						{item.institution}
					</p>
				))}
			</div>
		</div>

		<div class="about-extra-item">
			<h4>Idiomas</h4>
			<div>
				{about.languages.map((lang) => (
					<p><strong>{lang.name}</strong> - {lang.level}</p>
				))}
			</div>
		</div>

		<div class="about-extra-item">
			<h4>Hobbies</h4>
			<div>
				<p>{about.hobbies.join(' - ')}</p>
			</div>
		</div>
	</div>
</BaseLayout>

<style>

	img {
		max-width: 40%;
		height: auto;
		border-radius: 8px;
	}

	.about-extra {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 2em;
		justify-content: space-between;
	}
</style>
