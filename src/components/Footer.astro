---
import SocialLinks from './ui/SocialLinks.astro';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Martín Rojas.
	<SocialLinks />
</footer>

<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	:global(.social-links) {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	:global(.social-links a) {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	:global(.social-links a:hover) {
		color: rgb(var(--gray-dark));
	}
</style>
