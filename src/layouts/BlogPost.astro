---
import type { BlogPostData } from '../domain/types/blog';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

type Props = BlogPostData;

const { title, description, pubDate, updatedDate, heroImage, tags, githubUrl, demoUrl } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<article>
		<div class="hero-image">
			{heroImage && (
				<img
					width={1020}
					height={510}
					src={`${import.meta.env.BASE_URL}${heroImage}`}
					alt=""
				/>
			)}
		</div>
		<div class="prose">
			<div class="title">
				<h1>{title}</h1>
				{tags && tags.length > 0 && (
					<div class="tags">
						{tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				)}
				{(githubUrl || demoUrl) && (
					<div class="project-links">
						{githubUrl && (
							<a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-github">
								<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
									<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
								</svg>
								Ver código
							</a>
						)}
						{demoUrl && (
							<a href={demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-demo">
								<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
									<polyline points="15 3 21 3 21 9"/>
									<line x1="10" y1="14" x2="21" y2="3"/>
								</svg>
								Ver demo
							</a>
						)}
					</div>
				)}
				<div class="date">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span class="last-updated-on">
							· Actualizado: <FormattedDate date={updatedDate} />
						</span>
					)}
				</div>
				<hr />
			</div>
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.hero-image {
		width: 100%;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.prose {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
		color: rgb(var(--gray-dark));
	}
	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 0.75em 0;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		justify-content: center;
		margin-bottom: 1.25rem;
	}
	.tag {
		font-size: 0.8rem;
		padding: 0.25rem 0.7rem;
		background-color: rgba(35, 55, 255, 0.08);
		color: var(--accent);
		border-radius: 999px;
		font-weight: 600;
	}
	.project-links {
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		margin-bottom: 1.25rem;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 1.1rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(var(--gray), 30%);
	}
	.btn-github {
		background-color: rgb(var(--black));
		color: #fff;
	}
	.btn-demo {
		background-color: var(--accent);
		color: #fff;
	}
	.date {
		font-size: 0.875rem;
		color: rgb(var(--gray));
		margin-bottom: 0.75rem;
	}
	.last-updated-on {
		font-style: italic;
	}
</style>
